{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netcoop.local/schema/agent_message_v1_and_report.json",
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["device_id", "metric", "value", "unit", "interpretation"],
      "properties": {
        "device_id": {"type": "string"},
        "metric": {"type": "string"},
        "value": {},
        "unit": {"type": "string"},
        "interpretation": {"type": "string"},
        "source_message_id": {"type": "string"}
        ,"hypotheses": {"type":"array","items":{"type":"object","required":["cause","likelihood"],"properties":{"cause":{"type":"string"},"likelihood":{"type":"number","minimum":0,"maximum":1},"origin":{"enum":["model","rules"]}},"additionalProperties":false}}
      },
      "additionalProperties": true
    },
    "agent_message_v1": {
      "type": "object",
      "required": ["schema_version", "message_id", "timestamp", "source_agent", "target_agent", "status", "message_type", "conversation_id", "in_reply_to", "capability_card", "normalization", "findings", "evidence", "limitations"],
      "properties": {
        "schema_version": {"const": "agent_message_v1"},
        "message_id": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "format": "date-time"},
        "source_agent": {"type": "string", "minLength": 1},
        "target_agent": {"type": "string", "minLength": 1},
        "status": {"enum": ["ok", "warning", "error"]},
        "message_type":{"enum":["finding","task_request","challenge","ack"]},
        "conversation_id":{"type":"string"}, "in_reply_to":{"type":["string","null"]},
        "capability_card":{"type":"object"}, "normalization":{"type":"array","items":{"type":"object"}},
        "findings": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "received_message_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "ranked_candidate": {
      "type": "object",
      "required": ["cause", "score", "families", "evidence"],
      "properties": {
        "cause": {"type": "string"},
        "score": {"type": "number", "minimum": 0, "maximum": 0.95},
        "families": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      },
      "additionalProperties": true
    },
    "conflict": {
      "type": "object",
      "required": ["agents", "claims", "resolution_rule"],
      "properties": {
        "agents": {"type": "array", "items": {"type": "string"}},
        "claims": {"type": "array", "items": {"type": "string"}},
        "resolution_rule": {"type": "string"}
      },
      "additionalProperties": false
    },
    "model_review": {
      "type": "object",
      "required": ["status", "agrees_with_rule_verdict", "summary", "alternative_explanations", "recommended_checks", "uncertainty"],
      "properties": {
        "status": {"enum": ["reviewed", "unavailable"]},
        "agrees_with_rule_verdict": {"type": "boolean"},
        "summary": {"type": "string"},
        "alternative_explanations": {"type": "array", "items": {"type": "string"}},
        "recommended_checks": {"type": "array", "items": {"type": "string"}},
        "uncertainty": {"type": "string"}
      },
      "additionalProperties": false
    },
    "diagnostic_report": {
      "type": "object",
      "required": ["incident_id", "status", "suspected_root_cause", "confidence", "affected_devices", "supporting_evidence", "alternative_causes", "tied_candidates", "ranked_candidates", "recommended_actions", "evidence_sources", "limitations", "conflicts", "confidence_breakdown"],
      "properties": {
        "incident_id": {"type": "string"},
          "status": {"enum": ["diagnosed", "ambiguous", "insufficient_evidence", "healthy", "low_confidence"]},
        "suspected_root_cause": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 0.95},
        "affected_devices": {"type": "array", "items": {"type": "string"}},
        "supporting_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "alternative_causes": {"type": "array", "items": {"type": "string"}},
        "tied_candidates": {"type": "array", "items": {"type": "string"}},
        "ranked_candidates": {"type": "array", "items": {"$ref": "#/$defs/ranked_candidate"}},
        "recommended_actions": {"type": "array", "items": {"type": "string"}},
        "evidence_sources": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}},
        "confidence_breakdown": {"type": "object"},
          "incidents": {"type":"array","items":{"type":"object","required":["incident_id","device_ids","segment","cause","confidence","status","evidence"],"properties":{"incident_id":{"type":"string"},"device_ids":{"type":"array","items":{"type":"string"}},"segment":{"type":"string"},"cause":{"type":"string"},"confidence":{"type":"number","minimum":0,"maximum":0.95},"status":{"enum":["diagnosed","ambiguous","insufficient_evidence","healthy","low_confidence"]},"evidence":{"type":"array","items":{"$ref":"#/$defs/evidence"}},"recommended_actions":{"type":"array","items":{"type":"string"}}},"additionalProperties":true}},
        "model_review": {"$ref": "#/$defs/model_review"}
      },
      "additionalProperties": true
    }
  }
}
